# Copy to .dev.vars (Workers) or .env (scripts). Never commit the filled version.

# Neon — use the DIRECT connection string, not the pooled one.
# Hyperdrive does the pooling; doubling up causes problems.
DATABASE_URL=postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/nativeplants?sslmode=require

# Firebase project that issues the ID tokens we verify.
FIREBASE_PROJECT_ID=nativeplants-xxxxx

# Which market this deployment serves. Gates ingestion scope.
MARKET=wasatch-front
