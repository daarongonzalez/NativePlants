# Copy to .env (gitignored) and fill in. Never commit the filled version.
#
# Load it without the values landing in your scrollback:
#
#   set -a; source .env; set +a
#
# That matters more than it sounds. Typing `export VAR="...password..."` puts
# the credential in your shell history and in any screenshot of that terminal.
#
# Several tools want a Neon connection string under different names.
# Both take the DEV branch string, and the POOLED host is fine for both —
# these connect from your machine with `pg`, not through Hyperdrive.
#
# (The deployed Hyperdrive config already holds the DIRECT string on
# Cloudflare's side. You never set that here.)

# --- For `pnpm verify:data` and `pnpm db:migrate` ------------------------
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-wild-poetry-aexcp5tj-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- For `wrangler dev` on either Worker ---------------------------------
# wrangler cannot reach the deployed Hyperdrive config's credentials, so local
# dev needs its own connection string. The suffix is the BINDING name, which
# is HYPERDRIVE in both wrangler.toml files.
#
# THE PREFIX DEPENDS ON YOUR WRANGLER VERSION:
#   wrangler 3.x -> WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
#   wrangler 4.x -> CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
# Setting both is harmless and saves working out which you are on. The error
# message from `wrangler dev` names the one it wants.
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://neondb_owner:PASSWORD@ep-wild-poetry-aexcp5tj.c-2.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://neondb_owner:PASSWORD@ep-wild-poetry-aexcp5tj.c-2.us-east-2.aws.neon.tech:5432/neondb?sslmode=require

# --- For the database integration tests ----------------------------------
TEST_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-wild-poetry-aexcp5tj-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require
